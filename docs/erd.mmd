erDiagram
    User ||--o{ SafetyForm : submits
    User |o--o{ SafetyForm : reviews
    JobSite ||--o{ SafetyForm : "is for"
    SafetyForm ||--|{ SafetyFormPhoto : has

    User {
        int id PK
        string role
        string first_name
        string last_name
        timestamp created_at
    }

    JobSite {
        int id PK
        string address
        string name
        timestamp created_at
    }

    SafetyForm {
        int id PK
        int worker_id FK
        int jobsite_id FK
        date date
        bool ppe_worn
        bool hard_hat_worn
        bool vest_worn
        bool boots_worn
        bool eye_protection_worn
        bool fall_protection_inspected
        bool scaffolding_inspected
        bool ladders_inspected
        bool tools_inspected
        bool cords_inspected
        bool hazards_identified
        string notes
        string status
        int reviewed_by FK
        timestamp reviewed_at
        timestamp created_at
    }

    SafetyFormPhoto {
        int id PK
        int safety_form_id FK
        string path
        string content_type
        int size_bytes
        timestamp uploaded_at
    }