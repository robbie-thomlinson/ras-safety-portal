erDiagram
    AuthUser ||--|| Profile : has
    Profile ||--o{ SafetyForm : submits
    Profile |o--o{ SafetyForm : reviews
    JobSite ||--o{ SafetyForm : "is for"
    SafetyForm ||--|{ SafetyFormPhoto : has

    AuthUser {
        uuid id PK
        string email
    }

    Profile {
        uuid id PK, FK
        enum role
        string first_name
        string last_name
        timestamp created_at
    }

    JobSite {
        bigint id PK
        string name
        string address
        timestamp archived_at
        timestamp created_at
    }

    SafetyForm {
        bigint id PK
        uuid worker_id FK
        bigint job_site_id FK
        date date
        bool hard_hat_worn
        bool vest_worn
        bool boots_worn
        bool eye_protection_worn
        bool fall_protection_inspected
        bool scaffolding_inspected
        bool ladders_inspected
        bool tools_inspected
        bool cords_inspected
        bool hazards_identified
        string notes
        enum status
        uuid reviewed_by FK
        timestamp reviewed_at
        timestamp created_at
    }

    SafetyFormPhoto {
        bigint id PK
        bigint safety_form_id FK
        string path
        string content_type
        int size_bytes
        timestamp uploaded_at
    }
